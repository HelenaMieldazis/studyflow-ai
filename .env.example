# =============================================================================
# StudyFlow AI — variáveis de ambiente (MODELO)
# Copie para ".env" na raiz do repositório e preencha os valores.
# NUNCA faça commit do arquivo .env.
# =============================================================================

# --- Ambiente -----------------------------------------------------------------
# development | testing | production   (padrão seguro: production)
APP_ENV=development
LOG_LEVEL=INFO

# Chave secreta do Flask. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção a aplicação NÃO inicia com valor vazio, fraco ou com menos de 32 caracteres.
SECRET_KEY=

# --- Backend ------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
# Origens autorizadas (separadas por vírgula). Em produção: somente https://.
CORS_ORIGINS=http://localhost:5173
# Tamanho máximo do corpo das requisições, em bytes (1 MiB).
MAX_CONTENT_LENGTH=1048576

# --- PostgreSQL (usado pelo docker-compose) ------------------------------------
POSTGRES_USER=studyflow
# Defina uma senha forte e exclusiva. Não reutilize em produção.
POSTGRES_PASSWORD=
POSTGRES_DB=studyflow
POSTGRES_TEST_DB=studyflow_test
POSTGRES_PORT=5432

# --- Conexão do backend com o banco ----------------------------------------------
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
# Use a mesma senha definida em POSTGRES_PASSWORD (caracteres especiais devem ser URL-encoded).
DATABASE_URL=postgresql+psycopg://studyflow:SUA_SENHA_AQUI@127.0.0.1:5432/studyflow
# Banco exclusivo para testes (opcional; sem ele os testes usam SQLite em memória).
TEST_DATABASE_URL=postgresql+psycopg://studyflow:SUA_SENHA_AQUI@127.0.0.1:5432/studyflow_test
DATABASE_CONNECT_TIMEOUT=5

# --- Frontend (Vite) ------------------------------------------------------------
# Somente variáveis com prefixo VITE_ chegam ao navegador. NUNCA coloque segredos aqui.
# Em desenvolvimento o Vite faz proxy de /api para o backend; mantenha "/api".
VITE_API_BASE_URL=/api
# Destino do proxy de desenvolvimento do Vite (não é enviado ao navegador).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5001
